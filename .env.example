# Server Configuration
PORT=3000
NODE_ENV=development  # Change to production for deployment

# CORS - Open for all (optional: restrict if needed)
CORS_ORIGINS=*  # Allow all origins

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/reconciliation_db
MONGODB_DB_NAME=reconciliation_db

# Reconciliation Defaults
TIMESTAMP_TOLERANCE_SECONDS=300
QUANTITY_TOLERANCE_PCT=0.01

# Rate Limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=200  # 200 requests per window
RECONCILE_RATE_LIMIT_MAX=20  # 20 reconciliations per hour

# Logging
LOG_LEVEL=info  # debug, info, warn, error